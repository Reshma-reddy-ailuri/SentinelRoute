# Environment Variables Template for Enterprise GenAI Security Gateway
# Copy this file to .env and insert your real Groq API key.

# General Configuration
APP_NAME="Enterprise GenAI Security Gateway"
DEBUG=True

# Database Configuration (Defaults to local SQLite)
DATABASE_URL="sqlite:///./security_gateway.db"

# External LLM Provider Configuration
# Supported Providers: "groq" (default), "openai"
LLM_PROVIDER="groq"

# External LLM API Key (Obtain from https://console.groq.com)
LLM_API_KEY="your_groq_api_key_here"

# Configured LLM Model Name
# Groq Options: "llama-3.3-70b-versatile", "groq/compound-mini", "groq/compound"
# OpenAI Options: "gpt-4o-mini", "gpt-4o"
LLM_MODEL="llama-3.3-70b-versatile"

# Risk Policy Threshold Configuration
BLOCK_ON_PII=True
BLOCK_ON_CREDENTIALS=True
BLOCK_ON_SECRETS=True
BLOCK_ON_CONFIDENTIAL=True
