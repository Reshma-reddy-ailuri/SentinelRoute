# Enterprise GenAI Security Gateway Configuration

# Debug Mode
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///security_gateway.db

# External LLM Configuration
# Primary Provider: groq (Supports: groq, openai)
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile

# Risk Policy Threshold Configuration
BLOCK_ON_PII=True
BLOCK_ON_CREDENTIALS=True
BLOCK_ON_SECRETS=True
BLOCK_ON_CONFIDENTIAL=True
